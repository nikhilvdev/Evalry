# Generator service image: the only container that holds the LLM API key (plan §3). Installs the locked runtime dependencies
# and runs as a non-root user. Build from the repo root: docker build -f deploy/Dockerfile.generator .
# Base images are pinned by digest (security review F14); bump them deliberately and re-scan.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS build
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
RUN useradd --system --uid 10001 --no-create-home evalry
COPY --from=build /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER 10001
EXPOSE 8001
CMD ["evalry-generator"]
