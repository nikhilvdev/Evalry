# Generator service image: the only container that holds the LLM API key (plan §3). Installs the locked runtime dependencies
# and runs as a non-root user. Build from the repo root: docker build -f deploy/Dockerfile.generator .
# shortcut: tag-pinned base images; pin digests before the pilot, like the runner image.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim-bookworm
RUN useradd --system --uid 10001 --no-create-home evalry
COPY --from=build /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER 10001
EXPOSE 8001
CMD ["evalry-generator"]
