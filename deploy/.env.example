# Copy to deploy/.env and set real values. deploy/.env must never be committed.
EVALRY_PG_ADMIN_PASSWORD=change-me-admin
EVALRY_PG_APP_PASSWORD=change-me-app
EVALRY_PG_WORKER_PASSWORD=change-me-worker
EVALRY_S3_ACCESS_KEY=change-me-access
EVALRY_S3_SECRET_KEY=change-me-secret-min-8-chars
# Generator service (docker compose up generator). Model and prices are your decision: there are no defaults.
ANTHROPIC_API_KEY=change-me
EVALRY_GEN_MODEL=change-me
EVALRY_GEN_USD_PER_MTOK_IN=0
EVALRY_GEN_USD_PER_MTOK_OUT=0
EVALRY_GEN_TOKEN=change-me-at-least-32-characters-long
# Judge service (docker compose up judge). Same rules: no default model or prices; the rubric file is the eval owner's.
EVALRY_JUDGE_MODEL=change-me
EVALRY_JUDGE_USD_PER_MTOK_IN=0
EVALRY_JUDGE_USD_PER_MTOK_OUT=0
EVALRY_JUDGE_TOKEN=change-me-at-least-32-characters-long
EVALRY_JUDGE_RUBRIC_FILE=./judge-rubric.md
